<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="高德充电站无障碍采集终端"
            android:textColor="#102A20"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="通过无障碍服务按区县扫描高德地图充电站，读取详情与分时电价，再经服务端接口上报。"
            android:textColor="#496158"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="服务端配置"
            android:textColor="#102A20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/server_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="服务端地址，例如 https://collect.example.com/"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/activation_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="设备激活码"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/device_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="设备名称"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/save_config_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="保存配置" />

        <TextView
            android:id="@+id/service_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#E8F3ED"
            android:padding="12dp"
            android:textColor="#173D2C"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/open_accessibility_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="打开无障碍设置" />

        <Button
            android:id="@+id/open_amap_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开高德地图" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="设备调度"
            android:textColor="#102A20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/start_collect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="开始设备调度" />

        <Button
            android:id="@+id/stop_collect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="停止设备调度" />

        <Button
            android:id="@+id/sync_now_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="立即同步一次" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="本机扫描"
            android:textColor="#102A20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/city_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="城市"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/district_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="区县"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/keyword_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="搜索关键词，留空使用 重卡充电站"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/local_scan_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="开始本机扫描" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#E8F3ED"
            android:padding="12dp"
            android:textColor="#173D2C"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="运行日志"
            android:textColor="#102A20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F1F3F2"
            android:padding="12dp"
            android:paddingBottom="32dp"
            android:textColor="#263B33"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
