[Unit]
Description=Charging Station Operations Dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/amap-crawler-monitor/station-dashboard/backend
EnvironmentFile=/opt/amap-crawler-monitor/station-dashboard/backend/.env
ExecStart=/opt/amap-crawler-monitor/station-dashboard/backend/station-dashboard
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
